# Models: permitir somente os metadados/tokenizer do adapter conhecido.
# Pesos, checkpoints e futuros downloads permanecem locais por padrão.
/models/*
!/models/qwen2.5-3b-medical-lora/
/models/qwen2.5-3b-medical-lora/*
!/models/qwen2.5-3b-medical-lora/adapter_config.json
